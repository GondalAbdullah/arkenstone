{
  "expo": {
    "name": "Arkenstone",
    "slug": "arkenstone",
    "version": "0.1.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "arkenstone",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.abdullahgondal.arkenstone",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#F6F5F2",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F5F2",
          "image": "./assets/images/android-icon-foreground.png",
          "imageWidth": 140
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9281b614-0c3d-46cf-a933-4bb996894376"
      }
    },
    "owner": "datasaaz"
  }
}
